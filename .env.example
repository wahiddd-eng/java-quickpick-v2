# Java QuickPick V2 — environment template. PLACEHOLDERS ONLY. Never commit a real .env.
# V2 has its own database, ports and secrets; do not reuse V1's .env.
# SANDBOX MODE: real payments are disabled until the payment provider, a CA and the authorities approve the structure.

NODE_ENV=development
PORT=4100

# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) stored in PGLITE_DATA_DIR.
# For a real PostgreSQL: postgres://user:password@localhost:5432/java_quickpick_v2
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite-v2

# Required when NODE_ENV=production. Generate each with: openssl rand -hex 32
JWT_SECRET=replace-me
MOCK_WEBHOOK_SECRET=replace-me
# Hashes and encrypts pickup (collection) OTPs. Changing it invalidates codes for orders that are READY.
PICKUP_OTP_SECRET=replace-me

# Public addresses. QR codes point at STUDENT_APP_URL/s/<token>; checkout return URLs must be on these origins.
PUBLIC_API_URL=http://localhost:4100
STUDENT_APP_URL=http://localhost:5273
# Browser origins allowed to call the API (student, vendor, admin, and the Android vendor app).
CORS_ORIGINS=http://localhost:5273,http://localhost:5274,http://localhost:5275,capacitor://localhost,https://localhost

# Only "mock" exists. A Cashfree Easy Split adapter will be added only after written approval (docs/payments.md).
PAYMENT_PROVIDER=mock

# Push notifications: log (sandbox, records deliveries as SIMULATED) | fcm | none
PUSH_PROVIDER=log
# FCM HTTP v1 service account (only when PUSH_PROVIDER=fcm). Keep the key out of git.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
SMS_PROVIDER=none

# Optional error reporting (also: npm i -w @qp2/api @sentry/node)
SENTRY_DSN=
LOG_LEVEL=info

OTP_DEV_ECHO=true
MIN_LEAD_MINUTES=5
CHECKOUT_TTL_SECONDS=600
COLLECTION_WINDOW_MINUTES=120
PICKUP_OTP_MAX_ATTEMPTS=5
PRINT_MAX_ATTEMPTS=3
PRINT_CLAIM_SECONDS=45

# Frontend build-time settings (Vite)
# VITE_API_URL=http://localhost:4100
# VITE_FIREBASE_CONFIG={"apiKey":"…","projectId":"…","messagingSenderId":"…","appId":"…"}
# VITE_FIREBASE_VAPID_KEY=
